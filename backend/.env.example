# Copy to backend/.env for local runs. Never commit .env.
NLAB_DATABASE_URL=postgresql+asyncpg://nlab:nlab@localhost:5433/nlab
NLAB_SECRET_KEY=change-me-to-a-long-random-string
NLAB_PUBLIC_URL=http://localhost:8000
NLAB_COOKIE_SECURE=false
# Platform admins, pinned to provider + stable subject: {"google": ["<subject>"]}. Checked at every sign-in.
NLAB_SUPERADMIN_IDENTITIES={}
# Sign-in providers: set one or both.
NLAB_GOOGLE_CLIENT_ID=
NLAB_GOOGLE_CLIENT_SECRET=
NLAB_OIDC_NAME=sso
NLAB_OIDC_LABEL=Organisation sign-in
NLAB_OIDC_METADATA_URL=
NLAB_OIDC_CLIENT_ID=
NLAB_OIDC_CLIENT_SECRET=

# Language model (any OpenAI-compatible endpoint). Leave LLM_API_KEY empty to run without one.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
CLASSIFIER_REASONING_EFFORT=low
AVATAR_REASONING_EFFORT=low
EVALUATOR_THINKING=off

# Scenario generation: false creates one speaking counterpart; true allows multiple actors from the brief.
NLAB_ALLOW_MULTIPLE_COUNTERPARTS=false
# The grant check follows the CLASSIFIER_* settings; give it GRANT_API_KEY (etc.) only to use its own model.
