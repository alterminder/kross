# Admin/Compose-only configuration. Copy to .env next to compose.yml.
# NEVER commit .env; keep it mode 0600 (chmod 600 .env).
#
# This file is read by Docker Compose for interpolation ONLY. It is never given
# to the web app container: the owner password here cannot leak through the app.
# The app's own settings live in .env.app (copy .env.app.example).
# Every value is a PLACEHOLDER: replace them before the first start.
# Generate secrets: openssl rand -hex 32
# Put a value in single quotes if it contains `$`, `#` or spaces.

# OWNER/migration/bootstrap login (nlab). Used only by 'docker compose run
# migrate' and admin scripts; the web app connects as nlab_app instead.
POSTGRES_PASSWORD=CHANGE_ME_generate_openssl_rand_hex_32

# Restricted RUNTIME login (nlab_app: no DDL, no superuser). Must differ from
# POSTGRES_PASSWORD. Injected into the app as NLAB_DB_PASSWORD only.
POSTGRES_APP_PASSWORD=CHANGE_ME_generate_a_different_openssl_rand_hex_32

# Host loopback port the app is published on (the proxy connects here).
NLAB_HTTP_PORT=8000
