# Runtime settings for the web app. Copy to .env.app next to compose.yml.
# NEVER commit .env.app; keep it mode 0600 (chmod 600 .env.app).
#
# This file is mounted into the app container. It must NOT contain any
# POSTGRES_* owner/admin credential: the database owner password lives only in
# .env (admin file), and reaches the app as NLAB_DB_PASSWORD (runtime login).
# Every value is a PLACEHOLDER: production startup refuses to start until
# they are replaced.
# Put a value in single quotes if it contains `$`, `#` or spaces.

# Production mode: enforces HTTPS, secure cookies, positive retention and
# rejects placeholder secrets at startup. Keep true on the VPS.
NLAB_PRODUCTION=true

# Signs the short-lived cookie carrying OIDC state during sign-in.
NLAB_SECRET_KEY=CHANGE_ME_generate_openssl_rand_hex_32

# Public address (https only) and TLS behaviour.
NLAB_PUBLIC_URL=https://CHANGE_ME.your-domain.example
NLAB_COOKIE_SECURE=true

# Root path must stay EMPTY: this kit only supports root-path hosting.
# NLAB_ROOT_PATH=

# Address of the nginx->app peer that may set X-Forwarded-* headers.
# Usually the Compose network gateway; see docs/deployment.md (step 3).
# Never '*' or a whole private range.
NLAB_FORWARDED_ALLOW_IPS=CHANGE_ME_proxy_peer_address

# Platform administrators, pinned to provider + stable subject:
# JSON mapping of identity provider name to the list of subject IDs allowed to
# be platform admin. Email-only grants are not sufficient.
NLAB_SUPERADMIN_IDENTITIES={"google": ["CHANGE_ME_google_subject"], "sso": ["CHANGE_ME_oidc_subject"]}

# Sign-in: Google and/or your organisation's OpenID Connect provider.
# Leave a provider's fields empty to disable it.
NLAB_GOOGLE_CLIENT_ID=
NLAB_GOOGLE_CLIENT_SECRET=
NLAB_OIDC_NAME=sso
NLAB_OIDC_LABEL=Organisation sign-in
NLAB_OIDC_METADATA_URL=
NLAB_OIDC_CLIENT_ID=
NLAB_OIDC_CLIENT_SECRET=

# Language model: any OpenAI-compatible endpoint. Without LLM_API_KEY the app runs but cannot play.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
CLASSIFIER_REASONING_EFFORT=low
AVATAR_REASONING_EFFORT=low
EVALUATOR_THINKING=off

# Scenario generation: false creates one speaking counterpart; true allows multiple actors from the brief.
NLAB_ALLOW_MULTIPLE_COUNTERPARTS=false

# Daily limits (UTC); 0 switches one off.
# NLAB_MODEL_PRICES must price every configured model or the spend ceiling
# counts zero: {"<model>": [<USD/1M input>, <USD/1M output>]}
NLAB_LIMIT_USER_SESSIONS_PER_DAY=30
NLAB_LIMIT_USER_TOKENS_PER_DAY=1000000
NLAB_LIMIT_ORG_TOKENS_PER_DAY=10000000
NLAB_DAILY_SPEND_CEILING_USD=25
NLAB_MODEL_PRICES={}

# Write/storage admission (conservative cumulative allowances, not measured
# physical disk; alert on volume usage - see docs/deployment.md):
#   writes per day: user 500, org 5000, deployment 20000
#   storage: user 1GB, org 5GB, deployment 20GB
#   per write: minimum 1KB, scenarios/rules 2MB, sessions 1MB
NLAB_LIMIT_USER_WRITES_PER_DAY=500
NLAB_LIMIT_ORG_WRITES_PER_DAY=5000
NLAB_LIMIT_TOTAL_WRITES_PER_DAY=20000
NLAB_LIMIT_USER_STORAGE_BYTES=1000000000
NLAB_LIMIT_ORG_STORAGE_BYTES=5000000000
NLAB_LIMIT_TOTAL_STORAGE_BYTES=20000000000

# Retention: 365 matches the shipped privacy notice's "about 12 months".
# Schedule the daily purge: docs/deployment.md (step 4).
NLAB_SESSION_RETENTION_DAYS=365

# Guest play: an anonymous visitor starts at once, with no sign-in. Keep OFF
# until the per-address signup limits are deployed: one
# visitor can otherwise exhaust the shared daily signup quota. Guests may only
# play the curated scenarios alone, with their own daily caps (0 switches off).
NLAB_GUEST_PLAY=false
NLAB_GUEST_SESSION_HOURS=24
NLAB_GUEST_LIMIT_SESSIONS_PER_DAY=3        # per guest
NLAB_GUEST_LIMIT_TOKENS_PER_DAY=150000     # per guest
NLAB_GUEST_LIMIT_TOTAL_TOKENS_PER_DAY=2000000  # all guests together
NLAB_GUEST_LIMIT_SIGNUPS_PER_DAY=200       # new guests a day

# Questions to "Ask the Coach" per play session (0 switches the cap off).
NLAB_COACH_QUESTIONS_PER_SESSION=10
