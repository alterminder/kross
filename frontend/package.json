{
  "name": "nlab-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validators": "UPDATE_VALIDATORS=1 vitest run src/editor/validators.test.ts",
    "gen": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/google-sans-flex": "^5.3.2",
    "@fontsource/dm-sans": "^5.3.0",
    "@rjsf/core": "^6.11.1",
    "@rjsf/utils": "^6.11.0",
    "@rjsf/validator-ajv8": "^6.11.1",
    "marked": "^18.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
